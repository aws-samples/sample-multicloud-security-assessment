# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node
node_modules/
npm-debug.log*

# Generated assessment output (do not commit customer data / deliverables)
output/
*.pptx
*.pdf
*_Security_Dashboard.html
analysis.json
anon_map.json
charts/

# Exception: samples/ holds hand-checked, fully anonymized example deliverables that
# are meant to be committed. Without these negations the patterns above match them,
# so they would be dropped on any fresh `git add` (they currently survive only
# because Git ignores .gitignore for already-tracked files).
!samples/
!samples/**
